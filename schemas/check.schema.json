{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tells.blowhorn.ai/schemas/v1/check.schema.json",
  "title": "GET /api/check response",
  "description": "The success body of GET /api/check. Same schema_version, verdict and server as POST /api/report, without client or detections. Error bodies are not this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok", "receivedAt", "verdict", "server"],
  "properties": {
    "schema_version": { "$ref": "https://tells.blowhorn.ai/schemas/v1/report.schema.json#/$defs/schemaVersion" },
    "ok": { "const": true },
    "receivedAt": { "$ref": "https://tells.blowhorn.ai/schemas/v1/report.schema.json#/$defs/receivedAt" },
    "verdict": { "$ref": "https://tells.blowhorn.ai/schemas/v1/report.schema.json#/$defs/verdict" },
    "server": { "$ref": "https://tells.blowhorn.ai/schemas/v1/report.schema.json#/$defs/server" }
  }
}
