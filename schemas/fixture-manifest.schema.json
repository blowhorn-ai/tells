{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tells.blowhorn.ai/schemas/v1/fixture-manifest.schema.json",
  "title": "Known-good corpus manifest",
  "description": "Lists the captured report fixtures under tests/e2e/fixtures/captures: which browser each came from, its privacy settings, when it was captured and what was redacted. Written by scripts/capture-fixture.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fixtures": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "kind", "browser", "os", "privacySettings", "capturedOn", "redaction"],
      "properties": {
        "id": {
          "description": "Lower-case words joined by hyphens, for example brave-1-73-macos-15.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "file": {
          "description": "The fixture file in the captures directory, <id>.json.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.json$"
        },
        "kind": {
          "description": "human: a person's browser that must stay likely_human. automation: a stock automation tool that must be caught.",
          "enum": ["human", "automation"]
        },
        "browser": { "$ref": "#/$defs/nameAndVersion" },
        "os": { "$ref": "#/$defs/nameAndVersion" },
        "privacySettings": {
          "description": "Privacy features and extensions that were on, in the browser's own words. Empty for a default profile.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "capturedOn": {
          "description": "Capture date, YYYY-MM-DD.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["droppedHeaders", "removedFields"],
          "properties": {
            "droppedHeaders": {
              "description": "Request headers that were not kept, by name.",
              "type": "array",
              "items": { "type": "string" }
            },
            "removedFields": {
              "description": "Report fields that were removed or trimmed.",
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "nameAndVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
