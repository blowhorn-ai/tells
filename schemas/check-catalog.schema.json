{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tells.blowhorn.ai/schemas/v1/check-catalog.schema.json",
  "title": "Tells check catalog",
  "description": "The open catalog of every check row and every scored reason Tells already ships. catalog_version is the semver of this file. It is not a report field. A check with no scored reasons is still listed. A reason that does not change its row (fingerprint_randomized) is listed on its check with affects_row false. since is the released Tells version that added or last changed the entry, or master when the change is on master and has no release yet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "checks"],
  "properties": {
    "catalog_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "group", "slug", "page", "since", "reads", "rules", "reasons"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "group": { "enum": ["automation", "behavior", "fingerprint"] },
        "slug": { "type": "string", "minLength": 1 },
        "page": { "type": "string", "pattern": "^/checks/[a-z0-9-]+/$" },
        "since": { "$ref": "#/$defs/since" },
        "note": { "type": "string", "minLength": 1 },
        "reads": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "warn", "fail", "na"],
          "properties": {
            "pass": { "$ref": "#/$defs/rule" },
            "warn": { "$ref": "#/$defs/rule" },
            "fail": { "$ref": "#/$defs/rule" },
            "na": { "$ref": "#/$defs/rule" }
          }
        },
        "reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/reason" }
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "since"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "since": { "$ref": "#/$defs/since" },
        "note": { "type": "string", "minLength": 1 },
        "affects_row": { "type": "boolean" },
        "provisional": { "type": "boolean" },
        "severity": { "enum": ["high", "medium", "low"] },
        "points": { "type": "integer", "minimum": 0 },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "severity", "points"],
            "properties": {
              "status": { "enum": ["warn", "fail"] },
              "severity": { "enum": ["high", "medium", "low"] },
              "points": { "type": "integer", "minimum": 0 }
            }
          }
        }
      },
      "oneOf": [
        { "required": ["severity", "points"], "not": { "required": ["outcomes"] } },
        { "required": ["outcomes"], "not": { "anyOf": [{ "required": ["severity"] }, { "required": ["points"] }] } }
      ]
    },
    "rule": { "type": ["string", "null"], "minLength": 1 },
    "since": { "type": "string", "enum": ["v0.2.0", "v0.3.0", "v0.3.1", "v0.3.2", "v0.3.3", "master"] }
  }
}
