{
  "name": "blowhorn-tells",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "tells": "./bin/tells.js"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:validators": "node scripts/build-validators.mjs",
    "generate:checks": "node scripts/generate-check-pages.mjs",
    "check": "pnpm build:validators && node --check scripts/generate-check-pages.mjs && for file in src/*.js public/*.js bin/*.js; do node --check \"$file\"; done",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "pnpm check && pnpm test && pnpm test:e2e",
    "contrast": "node scripts/contrast.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "ghost-cursor": "^1.4.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "playwright": "1.64.1"
  }
}
