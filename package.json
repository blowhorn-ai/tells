{
  "name": "blowhorn-tells",
  "version": "0.3.11",
  "description": "Run the Blowhorn Tells bot-detection check from a terminal and print the JSON report and verdict.",
  "keywords": [
    "bot-detection",
    "browser-fingerprint",
    "headless",
    "playwright",
    "cli"
  ],
  "homepage": "https://tells.blowhorn.ai",
  "bugs": {
    "url": "https://github.com/blowhorn-ai/tells/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blowhorn-ai/tells.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "tells": "bin/tells.js"
  },
  "files": [
    "bin/tells.js",
    "src/cli.js",
    "schemas/cli-release.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:validators": "node scripts/build-validators.mjs",
    "generate:checks": "node scripts/generate-check-pages.mjs",
    "check": "pnpm build:validators && for file in src/*.js public/*.js bin/*.js scripts/*.mjs; do node --check \"$file\" || exit 1; done",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "pnpm check && pnpm test && pnpm test:e2e",
    "contrast": "node scripts/contrast.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "ghost-cursor": "^1.4.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "playwright": "1.64.1",
    "wrangler": "^4.151.3"
  }
}
