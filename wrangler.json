{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blowhorn-tells",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-12",
  "routes": [
    {
      "pattern": "tells.blowhorn.ai",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vars": {
    "IP_INTEL_PROVIDER": "ipapi"
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "REPORTS",
      "database_name": "blowhorn-tells-reports",
      "database_id": "09f21bd2-596e-4cac-bf57-219dcaa3243a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW",
      "bucket_name": "blowhorn-tells-raw"
    }
  ]
}
